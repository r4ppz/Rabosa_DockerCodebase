# Runtime data generated by the containers
mysql/data/
redis/data/*
!redis/data/.gitkeep

# Local SSL certificates (generate at deployment)
nginx/ssl/*.crt
nginx/ssl/*.key

# Runtime config files written by the Devilbox entrypoint into the mounted conf.d
php/conf.d/devilbox-runtime-*.ini
php/conf.d/zzz-entrypoint-*.ini

# Dev scratch directory for the workspace container
workspace/*
!workspace/.gitkeep

# OS / editor cruft
.DS_Store
Thumbs.db
*.log
.idea/
.vscode/
